          "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"kidays-fr\",pod=~\"(kidays-fr-app|kidays-fr-convex-backend)-.*\"}[$__rate_interval]))",
          "legendFormat": "",
          "range": false,
