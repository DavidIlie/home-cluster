          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_latency_bucket{service=~\"kidays-fr-app|kidays-fr-convex-backend\"}[$__rate_interval])))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A"
