    {
      "title": "Web server p95",
      "description": "Event-dependent until the application telemetry release is deployed. p95 latency of Next.js server request spans (closed route templates). No data until server telemetry is enabled. Kubernetes probe endpoints (/api/health*) are excluded.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-home-cluster"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2.5
              }
            ]
          },
          "noValue": "No data",
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-home-cluster"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_latency_bucket{service=\"libertos-web\",span_kind=\"SPAN_KIND_SERVER\",span_name!~\"GET /api/health.*\"}[$__rate_interval])))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "title": "Web server error ratio",
      "description": "Event-dependent until the application telemetry release is deployed. Share of server request spans with error status (5xx and thrown render errors). Kubernetes probe endpoints (/api/health*) are excluded.",
