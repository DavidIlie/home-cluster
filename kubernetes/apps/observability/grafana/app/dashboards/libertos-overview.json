          "editorMode": "code",
          "expr": "(sum(rate(traces_spanmetrics_calls_total{service=\"libertos-web\",span_kind=\"SPAN_KIND_SERVER\",span_name!~\"GET /api/health.*\",status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval])) or (0 * sum(rate(traces_spanmetrics_calls_total{service=\"libertos-web\",span_kind=\"SPAN_KIND_SERVER\",span_name!~\"GET /api/health.*\"}[$__rate_interval])))) / sum(rate(traces_spanmetrics_calls_total{service=\"libertos-web\",span_kind=\"SPAN_KIND_SERVER\",span_name!~\"GET /api/health.*\"}[$__rate_interval]))",
