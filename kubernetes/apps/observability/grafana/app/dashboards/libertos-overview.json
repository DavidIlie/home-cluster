    {
      "title": "Eve job outcomes \u00b7 range",
      "description": "Requires Convex telemetry. Finished Eve jobs by capability and outcome (span `eve.job.<capability> <outcome>`), estimated from span metrics over the selected range. Duration runs from job creation, so it includes queue time. A missing span is not a missing job; use Convex for one job's state.",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-home-cluster"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-home-cluster"
          },
          "editorMode": "code",
          "expr": "sum by (span_name) (increase(traces_spanmetrics_calls_total{service=\"libertos-convex\",span_name=~\"eve[.]job[.].+\"}[$__range]))",
          "legendFormat": "{{span_name}}",
          "range": false,
          "instant": true,
          "refId": "A",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
