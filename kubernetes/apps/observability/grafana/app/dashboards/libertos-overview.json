    {
      "type": "stat",
      "title": "Replicas available",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-davidapps-cluster"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-davidapps-cluster"
          },
          "editorMode": "code",
          "expr": "sum(kube_deployment_status_replicas_available{namespace=\"bostan-libertos\",deployment=~\"bostan-libertos-app|bostan-libertos-convex|bostan-libertos-pdf\"}) / clamp_min(sum(kube_deployment_spec_replicas{namespace=\"bostan-libertos\",deployment=~\"bostan-libertos-app|bostan-libertos-convex|bostan-libertos-pdf\"}), 1)",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.99
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
