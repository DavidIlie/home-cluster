    {
      "id": 10,
      "title": "Recent error logs",
      "type": "logs",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victoria-logs"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "options": {
        "dedupStrategy": "none",
        "enableInfiniteScrolling": true,
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": true,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victoria-logs"
          },
          "editorMode": "code",
          "expr": "_stream: {k_namespace_name=\"personal-projects\", cluster=\"davidapps-cluster\"} app:in(\"mbretrofit-tools\",\"mbretrofit-tools-zenzefi\") _msg:~\"(?i)(error|exception|fatal|panic)\" | fields _time, app, k_pod_name, k_container_name, trace_id | sort by (_time) desc | limit 200",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "description": "Pod errors. Expand trace_id to use the VictoriaLogs datasource View trace link; Tempo provides the reverse log link. Treat messages as potentially sensitive. Default rows omit raw messages; inspect text only through a separately authorized, redacted investigation."
    },
    {
