  "panels": [
    {
      "id": 1,
      "title": "Replica availability",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-davidapps-cluster"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-davidapps-cluster"
          },
          "editorMode": "code",
          "expr": "sum(kube_deployment_status_replicas_available{namespace=\"personal-projects\",deployment=~\"mbretrofit-tools|mbretrofit-tools-zenzefi\"}) / clamp_min(sum(kube_deployment_spec_replicas{namespace=\"personal-projects\",deployment=~\"mbretrofit-tools|mbretrofit-tools-zenzefi\"}), 1)",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
