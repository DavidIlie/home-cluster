      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-home-cluster"
          },
          "editorMode": "code",
          "expr": "(sum(rate(traces_spanmetrics_calls_total{service=\"mbretrofit-tools\",span_kind=\"SPAN_KIND_SERVER\",status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval])) or (0 * sum(rate(traces_spanmetrics_calls_total{service=\"mbretrofit-tools\",span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])))) / sum(rate(traces_spanmetrics_calls_total{service=\"mbretrofit-tools\",span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "description": "Sampled server spans only. Empty data can mean absent instrumentation, sampling or an idle service. These are not authoritative request counts. Returns zero when traffic exists without an error series; idle or absent traffic does not report a healthy zero."
    },
