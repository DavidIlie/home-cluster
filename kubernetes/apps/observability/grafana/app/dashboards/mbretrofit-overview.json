          "editorMode": "code",
          "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"personal-projects\",pod=~\"(mbretrofit-tools|mbretrofit-tools-zenzefi)-.*\"}[$__range]))",
          "legendFormat": "",
