          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victoria-logs"
          },
          "editorMode": "code",
          "expr": "collector:\"alloy\" app_name:\"zerocut-web\" kind:\"measurement\" | stats by (_time:5m, app_version) quantile(0.75, lcp) if (lcp:*) as lcp_p75",
          "legendFormat": "{{app_version}}",
