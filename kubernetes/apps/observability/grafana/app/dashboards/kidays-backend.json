      "title": "Stripe webhooks",
      "type": "row"
    },
    {
      "title": "Stripe deliveries by type and outcome",
      "description": "One span per signature-verified delivery: `stripe.webhook <event type|_other> <processed|duplicate|retry_requested|rejected|failed>`. Unverified or throttled requests are not recorded; `_unverified failed` is a server fault before verification.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-home-cluster"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No data",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-home-cluster"
          },
          "editorMode": "code",
          "expr": "sum by (span_name) (rate(traces_spanmetrics_calls_total{service=\"kidays-fr-convex-backend\",span_name=~\"stripe\\\\.webhook .+\"}[$__rate_interval]))",
          "legendFormat": "{{span_name}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "id": 2,
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 1
      }
    },
    {
      "title": "Stripe webhook faults · range",
