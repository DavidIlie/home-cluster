{
  "id": null,
  "uid": "libertos-engine-pipeline",
  "title": "Libertos / Engine pipeline",
  "description": "Libertos engine operations. TODO panels identify telemetry that is not exported. No data is not zero.",
  "tags": [
    "libertos",
    "engine"
  ],
  "timezone": "utc",
  "schemaVersion": 40,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m",
      "15m"
    ]
  },
  "links": [
    {
      "type": "link",
      "title": "Engine pipeline",
      "url": "/d/libertos-engine-pipeline",
      "includeVars": true,
      "keepTime": true
    },
    {
      "type": "link",
      "title": "Archive sweep",
      "url": "/d/libertos-archive-sweep",
      "includeVars": true,
      "keepTime": true
    },
    {
      "type": "link",
      "title": "Cost",
      "url": "/d/libertos-cost",
      "includeVars": true,
      "keepTime": true
    },
    {
      "type": "link",
      "title": "Briefing drill-down",
      "url": "/d/libertos-briefing-drilldown",
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "engineMetrics",
        "label": "Engine metrics",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "prometheus-davidapps-cluster",
          "value": "prometheus-davidapps-cluster"
        },
        "options": [],
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "stepDuration",
        "type": "constant",
        "query": "libertos_engine_step_duration_seconds",
        "current": {
          "text": "libertos_engine_step_duration_seconds",
          "value": "libertos_engine_step_duration_seconds"
        },
        "hide": 2,
        "skipUrlSync": true
      },
      {
        "name": "stepFailures",
        "type": "constant",
        "query": "libertos_engine_step_failures_total",
        "current": {
          "text": "libertos_engine_step_failures_total",
          "value": "libertos_engine_step_failures_total"
        },
        "hide": 2,
        "skipUrlSync": true
      },
      {
        "name": "briefingOutcomes",
        "type": "constant",
        "query": "libertos_engine_briefings_total",
        "current": {
          "text": "libertos_engine_briefings_total",
          "value": "libertos_engine_briefings_total"
        },
        "hide": 2,
        "skipUrlSync": true
      },
      {
        "name": "stuckDetections",
        "type": "constant",
        "query": "libertos_engine_stuck_total",
        "current": {
          "text": "libertos_engine_stuck_total",
          "value": "libertos_engine_stuck_total"
        },
        "hide": 2,
        "skipUrlSync": true
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Telemetry coverage",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "options": {
        "mode": "markdown",
        "content": "Metric names and closed labels match engineOtel's published contract. Direct metrics are blocked on delta-to-cumulative ingestion in Alloy; empty panels mean unavailable telemetry, not zero.\n\nThe completed-job charts and Tempo trace table use the current export. Engine spans will appear after the producer is deployed."
      }
    },
    {
      "id": 2,
      "title": "Briefing delivery outcomes per rolling hour",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${engineMetrics}"
      },
      "description": "Canonical outcomes are on_time, late and short, grouped by tier. Emission boundaries and overlap semantics still require producer verification. Direct metrics need the ingestion fix.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${engineMetrics}"
          },
          "expr": "sum by (outcome, tier) (increase(${briefingOutcomes}[1h]))",
          "legendFormat": "{{tier}} · {{outcome}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 3,
      "title": "Step duration p50 / p95",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${engineMetrics}"
      },
      "description": "Direct engine histogram with buckets through 3600 seconds. Terminal steps only; held and started observations are excluded. Direct metrics need the ingestion fix.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${engineMetrics}"
          },
          "expr": "histogram_quantile(0.50, sum by (le, step, tier) (rate(${stepDuration}_bucket{status=~\"succeeded|failed|cancelled\"}[$__rate_interval])))",
          "legendFormat": "{{tier}} · {{step}} p50",
          "range": true,
          "instant": false,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${engineMetrics}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, step, tier) (rate(${stepDuration}_bucket{status=~\"succeeded|failed|cancelled\"}[$__rate_interval])))",
          "legendFormat": "{{tier}} · {{step}} p95",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 4,
      "title": "Failures by step and tier",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${engineMetrics}"
      },
      "description": "The failure counter has step and tier labels. Error codes are span attributes and appear in the Tempo breakdown below.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${engineMetrics}"
          },
          "expr": "sum by (step, tier) (increase(${stepFailures}[1h]))",
          "legendFormat": "{{tier}} · {{step}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 5,
      "title": "Stuck detections per rolling hour",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${engineMetrics}"
      },
      "description": "Detections, not active stuck jobs. Canonical reasons: lease_expired, no_step_progress, retries_exhausted, research_deadline, writing_deadline, delivery_overdue. Direct metrics need the ingestion fix.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${engineMetrics}"
          },
          "expr": "sum by (step, reason) (increase(${stuckDetections}[1h]))",
          "legendFormat": "{{step}} · {{reason}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 6,
      "title": "On-time share of delivery outcomes · provisional",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${engineMetrics}"
      },
      "description": "Rolling 24-hour share, pending the canonical per-morning contract. Outcome must be evaluated against the reader's profile schedule. An absent or zero denominator stays unknown.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${engineMetrics}"
          },
          "expr": "100 * sum(increase(${briefingOutcomes}{outcome=\"on_time\"}[1d])) / sum(increase(${briefingOutcomes}[1d]))",
          "legendFormat": "on time",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 7,
      "title": "TODO · Active briefings stuck over 15 minutes",
      "type": "text",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "options": {
        "mode": "markdown",
        "content": "A stuck-detection counter cannot measure how many jobs remain stuck or how long. Requires active age since last progress, cleared on terminal state. stuckWatch currently uses adaptive thresholds, so its events do not prove a fixed 15-minute breach."
      }
    },
    {
      "id": 8,
      "title": "TODO · On-time rate per reader morning",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "options": {
        "mode": "markdown",
        "content": "Needs the canonical morning outcome contract. The provisional share above uses a rolling 24-hour window. Confirm that late and short are mutually exclusive before using their sum as the delivery denominator."
      }
    },
    {
      "id": 9,
      "title": "Alerts and missing data",
      "type": "text",
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "options": {
        "mode": "markdown",
        "content": "Completed-job error rate uses verified Tempo metrics. Late/short delivery needs the direct-metric ingestion fix. Fixed 15-minute stuck age, sweep completion after 04:00Z and daily-ceiling alerts lack the required signals."
      }
    },
    {
      "id": 10,
      "title": "Briefing job completions per rolling hour",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-home-cluster"
      },
      "description": "Completed briefing jobs, grouped by the outcome encoded in the current span name. Counter extrapolation can produce fractional counts. Does not count deliveries.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-home-cluster"
          },
          "expr": "sum by (outcome) (label_replace(increase(traces_spanmetrics_calls_total{service=\"libertos-convex\",span_name=~\"eve[.]job[.]briefing (succeeded|failed|cancelled)\"}[1h]), \"outcome\", \"$1\", \"span_name\", \".* (succeeded|failed|cancelled)\"))",
          "legendFormat": "{{outcome}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 11,
      "title": "Completed job failures per rolling hour",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 37,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-home-cluster"
      },
      "description": "Completed job errors. Detailed step and error-code breakdown awaits engineOtel; current error.type is only job_failed.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-home-cluster"
          },
          "expr": "sum by (span_name) (increase(traces_spanmetrics_calls_total{service=\"libertos-convex\",span_name=~\"eve[.]job[.].*\",status_code=\"STATUS_CODE_ERROR\"}[1h]))",
          "legendFormat": "{{span_name}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 12,
      "title": "Recent engine traces",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 45,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"libertos-convex\" && (name =~ \"libertos[.]engine[.].*\" || name =~ \"eve[.]job[.].*\") }",
          "limit": 30,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "traceID"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Briefing drill-down",
                    "url": "/d/libertos-briefing-drilldown?var-traceId=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 13,
      "title": "Step failures by error code · Tempo",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 53,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "description": "Count of failed engine spans per query interval, grouped by the canonical step and error_code attributes. Independent of direct OTLP metric ingestion.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "metricsQueryType": "range",
          "query": "{ resource.service.name = \"libertos-convex\" && name =~ \"libertos[.]engine[.].*\" && span.libertos.engine.status = \"failed\" } | count_over_time() by (span.libertos.engine.step, span.libertos.engine.error_code)"
        }
      ]
    }
  ]
}
