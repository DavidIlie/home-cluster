{
  "datasources": [
    {
      "uid": "prometheus-davidapps-cluster",
      "kind": "prometheus",
      "upstream": "http://prometheus-davidapps-cluster.observability.svc.cluster.local:9090"
    },
    {
      "uid": "prometheus-home-cluster",
      "kind": "prometheus",
      "upstream": "http://prometheus-home-cluster.observability.svc.cluster.local:9090"
    },
    {
      "uid": "victoria-logs",
      "kind": "victorialogs",
      "upstream": "http://victoria-logs-server.observability.svc.cluster.local:9428"
    }
  ],
  "scope": {
    "prometheusMatchers": {
      "namespace": [
        "bostan-enterprise",
        "bostan-libertos",
        "bostan-swish"
      ],
      "exported_namespace": [
        "bostan-enterprise",
        "bostan-libertos",
        "bostan-swish"
      ],
      "host": [
        "bostanenterprise.com",
        "employee.bostanenterprise.com",
        "libertos.org",
        "server.libertos.org",
        "actions.libertos.org",
        "swishshop.net",
        "www.swishshop.net",
        "api.swishshop.net",
        "auth.swishshop.net"
      ],
      "service": [
        "libertos-web",
        "libertos-convex"
      ],
      "davidapps_project_id": [
        "libertos"
      ],
      "deployment": [
        "bostan-discord-bot"
      ],
      "tunnel_id": [
        "dd1a83cb-2105-442d-972a-97d0f4c0623f"
      ]
    },
    "logsStreamPrefixes": [
      "_stream:{cluster=\"davidapps-cluster\",k_namespace_name=\"bostan-enterprise\"}",
      "_stream:{cluster=\"davidapps-cluster\",k_namespace_name=\"bostan-libertos\"}",
      "_stream:{cluster=\"davidapps-cluster\",k_namespace_name=\"bostan-swish\"}",
      "_stream:{cluster=\"davidapps-cluster\",k_namespace_name=\"bostan-enterprise\",app=\"bostan-enterprise-cloudflared\"}",
      "_stream:{cluster=\"davidapps-cluster\",k_namespace_name=\"bostan-enterprise\",app=\"external-dns\"}",
      "_stream:{cluster=\"davidapps-cluster\",k_namespace_name=\"network\",app=\"ingress-nginx\"} vhost:in(\"bostanenterprise.com\",\"employee.bostanenterprise.com\",\"libertos.org\",\"server.libertos.org\",\"actions.libertos.org\",\"swishshop.net\",\"www.swishshop.net\",\"api.swishshop.net\",\"auth.swishshop.net\")",
      "_stream:{cluster=\"home-cluster\",k_namespace_name=\"default\",app=\"bostan-discord-bot\"}"
    ]
  },
  "limits": {
    "maxRangeSeconds": 2592000,
    "horizonSeconds": 2592000,
    "maxFutureSkewSeconds": 300,
    "maxPoints": 11000,
    "minStepSeconds": 1,
    "maxLogLimit": 1000,
    "maxResponseBytes": 16777216,
    "upstreamTimeoutSeconds": 30
  }
}
