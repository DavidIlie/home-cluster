{
  "uid": "ludwig-overview",
  "title": "Ludwig overview",
  "schemaVersion": 39,
  "tags": [
    "ludwig"
  ],
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Available / desired deployment replicas",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-davidapps-cluster"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_deployment_status_replicas_available{namespace=\"ludwig\"} / clamp_min(kube_deployment_spec_replicas{namespace=\"ludwig\"}, 1)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-davidapps-cluster"
          },
          "editorMode": "code",
          "legendFormat": "{{deployment}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Container restarts",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-davidapps-cluster"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (increase(kube_pod_container_status_restarts_total{namespace=\"ludwig\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-davidapps-cluster"
          },
          "editorMode": "code",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Public ingest outcomes",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-davidapps-cluster"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route, result) (rate(telemetry_gateway_requests_total{project=\"ludwig\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-davidapps-cluster"
          },
          "editorMode": "code",
          "legendFormat": "{{route}} · {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Span throughput",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-home-cluster"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=~\"ludwig-browser|ludwig-web|ludwig-convex\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-home-cluster"
          },
          "editorMode": "code",
          "legendFormat": "Spans/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Span error ratio",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-home-cluster"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=~\"ludwig-browser|ludwig-web|ludwig-convex\",status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval])) / clamp_min(sum(rate(traces_spanmetrics_calls_total{service=~\"ludwig-browser|ludwig-web|ludwig-convex\"}[$__rate_interval])), 0.000001)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-home-cluster"
          },
          "editorMode": "code",
          "legendFormat": "Errors"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Span latency",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-home-cluster"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(traces_spanmetrics_latency_bucket{service=~\"ludwig-browser|ludwig-web|ludwig-convex\"}[$__rate_interval])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-home-cluster"
          },
          "editorMode": "code",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_latency_bucket{service=~\"ludwig-browser|ludwig-web|ludwig-convex\"}[$__rate_interval])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-home-cluster"
          },
          "editorMode": "code",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Tutor turn latency",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-home-cluster"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(traces_spanmetrics_latency_bucket{service=\"ludwig-convex\",span_name=\"tutor.turn\"}[$__rate_interval])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-home-cluster"
          },
          "editorMode": "code",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_latency_bucket{service=\"ludwig-convex\",span_name=\"tutor.turn\"}[$__rate_interval])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-home-cluster"
          },
          "editorMode": "code",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Ask request latency",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-home-cluster"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(traces_spanmetrics_latency_bucket{service=\"ludwig-browser\",span_name=\"ask.request\"}[$__rate_interval])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-home-cluster"
          },
          "editorMode": "code",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_latency_bucket{service=\"ludwig-browser\",span_name=\"ask.request\"}[$__rate_interval])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-home-cluster"
          },
          "editorMode": "code",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "First-token latency",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victoria-logs"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "_stream:{\"davidapps.project.id\"=\"ludwig\",\"service.name\"=\"ludwig-convex\"} _msg:=\"gen_ai.model\" \"ludwig.first_token_ms\":* | stats by (_time:5m) quantile(0.50, \"ludwig.first_token_ms\") as p50, quantile(0.95, \"ludwig.first_token_ms\") as p95",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victoria-logs"
          },
          "editorMode": "code",
          "legendFormat": "",
          "queryType": "statsRange"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Model spend today (UTC)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-davidapps-cluster"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (deployment_environment_name) ({__name__=~\"ludwig_model_spend_today(_USD)?\",davidapps_project_id=\"ludwig\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-davidapps-cluster"
          },
          "editorMode": "code",
          "legendFormat": "{{deployment_environment_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Model calls by role and outcome",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victoria-logs"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "_stream:{\"davidapps.project.id\"=\"ludwig\",\"service.name\"=\"ludwig-convex\"} _msg:=\"gen_ai.model\" | stats by (_time:5m, \"ludwig.model.role\", \"ludwig.outcome\") count()",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victoria-logs"
          },
          "editorMode": "code",
          "legendFormat": "",
          "queryType": "statsRange"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "title": "Tool errors by tool name",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victoria-logs"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "_stream:{\"davidapps.project.id\"=\"ludwig\",\"service.name\"=\"ludwig-convex\"} _msg:=\"gen_ai.tool\" \"ludwig.status\":=\"error\" | stats by (_time:5m, \"gen_ai.tool.name\") count()",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victoria-logs"
          },
          "editorMode": "code",
          "legendFormat": "",
          "queryType": "statsRange"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "title": "Access denials by capability",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victoria-logs"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "_stream:{cluster=\"davidapps-cluster\",k_namespace_name=\"ludwig\"} k_container_name:=\"stream\" event:=\"access.denied\" | stats by (_time:5m, capability) count()",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victoria-logs"
          },
          "editorMode": "code",
          "legendFormat": "",
          "queryType": "statsRange"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "title": "Web Vitals p75",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victoria-logs"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "_stream:{cluster=\"davidapps-cluster\",collector=\"alloy\"} app_name:=\"ludwig-browser\" kind:=\"measurement\" lcp:* | stats by (_time:5m) quantile(0.75, lcp) as lcp_p75",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victoria-logs"
          },
          "editorMode": "code",
          "legendFormat": "LCP",
          "queryType": "statsRange"
        },
        {
          "refId": "B",
          "expr": "_stream:{cluster=\"davidapps-cluster\",collector=\"alloy\"} app_name:=\"ludwig-browser\" kind:=\"measurement\" inp:* | stats by (_time:5m) quantile(0.75, inp) as inp_p75",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victoria-logs"
          },
          "editorMode": "code",
          "legendFormat": "INP",
          "queryType": "statsRange"
        },
        {
          "refId": "C",
          "expr": "_stream:{cluster=\"davidapps-cluster\",collector=\"alloy\"} app_name:=\"ludwig-browser\" kind:=\"measurement\" fcp:* | stats by (_time:5m) quantile(0.75, fcp) as fcp_p75",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victoria-logs"
          },
          "editorMode": "code",
          "legendFormat": "FCP",
          "queryType": "statsRange"
        },
        {
          "refId": "D",
          "expr": "_stream:{cluster=\"davidapps-cluster\",collector=\"alloy\"} app_name:=\"ludwig-browser\" kind:=\"measurement\" ttfb:* | stats by (_time:5m) quantile(0.75, ttfb) as ttfb_p75",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victoria-logs"
          },
          "editorMode": "code",
          "legendFormat": "TTFB",
          "queryType": "statsRange"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "title": "Cumulative layout shift p75",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victoria-logs"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "_stream:{cluster=\"davidapps-cluster\",collector=\"alloy\"} app_name:=\"ludwig-browser\" kind:=\"measurement\" cls:* | stats by (_time:5m) quantile(0.75, cls) as cls_p75",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victoria-logs"
          },
          "editorMode": "code",
          "legendFormat": "CLS",
          "queryType": "statsRange"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 16,
      "title": "Recent errors",
      "type": "logs",
      "gridPos": {
        "x": 12,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victoria-logs"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "_stream:{cluster=\"davidapps-cluster\",k_namespace_name=\"ludwig\"} k_container_name:=\"stream\" event:in(\"operation.failed\",\"access.denied\") | fields _time, _msg, event, operation, capability, trace_id, span_id | limit 100",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victoria-logs"
          },
          "editorMode": "code",
          "legendFormat": "",
          "queryType": "instant"
        },
        {
          "refId": "B",
          "expr": "_stream:{\"davidapps.project.id\"=\"ludwig\",\"service.name\"=\"ludwig-convex\"} \"ludwig.status\":=\"error\" | fields _time, _msg, event, operation, capability, trace_id, span_id | limit 100",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victoria-logs"
          },
          "editorMode": "code",
          "legendFormat": "",
          "queryType": "instant"
        },
        {
          "refId": "C",
          "expr": "_stream:{cluster=\"davidapps-cluster\",collector=\"alloy\"} app_name:=\"ludwig-browser\" kind:=\"exception\" value:=\"browser.error\" | fields _time, value, trace_id, span_id | rename value as _msg | limit 100",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victoria-logs"
          },
          "editorMode": "code",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 17,
      "title": "Active releases",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 64,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-home-cluster"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (job, service_version) (traces_target_info{davidapps_project_id=\"ludwig\",service_version!=\"\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-home-cluster"
          },
          "editorMode": "code",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "service_version"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open deployed commit",
                    "url": "https://github.com/BostanEnterprise/ludwig/commit/${__value.raw}"
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  ]
}
