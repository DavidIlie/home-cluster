    {
      "title": "LCP p75 by release",
      "description": "Browser collection is disabled pending the application owner consent decision. These queries reserve the libertos-browser contract; no traffic is expected yet. Event-dependent on consenting browser traffic. Browser payload identity is public and forgeable.",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victoria-logs"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2500
              },
              {
                "color": "red",
                "value": 4000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victoria-logs"
          },
          "editorMode": "code",
          "expr": "_stream:{cluster=\"davidapps-cluster\",collector=\"alloy\"} app_name:=\"libertos-browser\" kind:\"measurement\" app_version:~\"^[0-9a-f]{40}$\" | stats by (_time:15m, app_version) quantile(0.75, lcp) if (lcp:*) as lcp_p75",
          "legendFormat": "{{app_version}}",
          "queryType": "statsRange",
          "refId": "A"
        }
      ],
      "id": 2,
      "gridPos": {
