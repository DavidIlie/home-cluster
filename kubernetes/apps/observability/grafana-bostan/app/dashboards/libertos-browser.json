    {
      "title": "Browser releases observed in range",
      "description": "Browser collection is disabled pending the application owner consent decision. These queries reserve the libertos-browser contract; no traffic is expected yet. Observed full browser SHAs in the selected range, not authoritative deployment state.",
      "type": "table",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victoria-logs"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "app_version"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open observed commit",
                    "url": "https://github.com/BostanEnterprise/libertos/commit/${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victoria-logs"
          },
          "editorMode": "code",
          "expr": "_stream:{cluster=\"davidapps-cluster\",collector=\"alloy\"} app_name:=\"libertos-browser\" app_version:~\"^[0-9a-f]{40}$\" | stats by (app_version) count() as signals | sort by (signals desc) | limit 20",
          "queryType": "stats",
          "refId": "A"
        }
      ],
